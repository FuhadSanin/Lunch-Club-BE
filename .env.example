# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Local only (needs DJANGO_DEBUG=true): requests without a token sign in as this email.
DEV_AUTH_EMAIL=

# PostgreSQL. On Cloud Run, DB_HOST is /cloudsql/<project>:<region>:<instance>.
# The app's role must not be a superuser, or row-level security is skipped.
DB_NAME=lunch
DB_USER=lunch
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Cloud and Firebase. Credentials come from the runtime service account
# (or `gcloud auth application-default login` locally).
GCP_PROJECT=
# Firebase project for Google sign-in (defaults to GCP_PROJECT).
FIREBASE_PROJECT_ID=
GCP_REGION=asia-south1
APP_URL=http://localhost:5173

# Off locally: due jobs run inline and the live board and push are skipped.
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_QUEUE=lunch-jobs
TASKS_BASE_URL=https://<this-service>.a.run.app
TASKS_SERVICE_ACCOUNT=lunch-tasks@<project>.iam.gserviceaccount.com
FIRESTORE_ENABLED=false
PUSH_ENABLED=false

# Ordering
ORDER_PROVIDER=apps.ordering.providers.manual.ManualProvider
# Or apps.ordering.providers.swiggy_web.SwiggyWebProvider to fill the host's Swiggy cart
# (needs `uv sync --group bot`). Attach to a logged-in Chrome started with
# --remote-debugging-port=9222:
# SWIGGY_BOT_CDP_URL=http://127.0.0.1:9222
# One Swiggy order per restaurant (the bot fills one cart at a time)
MAX_RESTAURANTS_PER_ORDER=1
PLACEMENT_LEASE_SECONDS=600
DELIVERY_POLL_SECONDS=300

# Swiggy catalog (restaurants and menus)
SWIGGY_TIMEOUT_SECONDS=20
SWIGGY_CACHE_SECONDS=600

# Email (console backend prints mail locally)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=lunch@example.com

# Error alerts
SENTRY_DSN=

# Public email domains never form a company: each person there hosts their own party.
# PUBLIC_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com
# Address suggestions use OpenStreetMap (Photon and Nominatim); answers are cached a day.
# PLACES_SUGGEST_URL=https://photon.komoot.io/api/
# PLACES_LOOKUP_URL=https://nominatim.openstreetmap.org/lookup
# PLACES_CACHE_SECONDS=86400
