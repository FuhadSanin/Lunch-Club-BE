# Production (Vercel + Neon). Set these in Vercel -> Project -> Settings ->
# Environment Variables (Production). This file is a template: never put real
# passwords or connection strings in it, it is committed to git.

# Django
DJANGO_SECRET_KEY=<openssl rand -base64 48>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=lunchclubbe.vercel.app,.vercel.app
LOG_LEVEL=INFO

# Neon adds DATABASE_URL itself when you connect it to the project (the pooled URL).
# Run migrations once against DATABASE_URL_UNPOOLED:
#   DATABASE_URL='<unpooled url>' DJANGO_SECRET_KEY=x DJANGO_DEBUG=false \
#     uv run python manage.py migrate
DATABASE_URL=<added by the Neon integration>

# Firebase sign-in, and where the web app lives
FIREBASE_PROJECT_ID=lunchclub-fa2d4
APP_URL=https://lunchclubfe.vercel.app

# No Cloud Tasks, Firestore or push on Vercel; the order bot needs your own Chrome.
CLOUD_TASKS_ENABLED=false
FIRESTORE_ENABLED=false
PUSH_ENABLED=false
ORDER_PROVIDER=apps.ordering.providers.manual.ManualProvider
MAX_RESTAURANTS_PER_ORDER=1
